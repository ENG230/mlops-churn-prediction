{
  "name": "MLOps Churn Prediction",

  // Using GitHub's Universal image — has Python, Docker, Node, git pre-installed
  // No feature installation needed → faster startup, no GPG key errors
  "image": "mcr.microsoft.com/devcontainers/universal:2",

  // Auto-run setup script after container creation
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Auto-forward ports so you can click to open in browser
  "forwardPorts": [8000, 5000],

  "portsAttributes": {
    "8000": {
      "label": "FastAPI - Churn Prediction API",
      "onAutoForward": "openPreview"
    },
    "5000": {
      "label": "MLflow UI - Experiment Tracking",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylance",
        "ms-azuretools.vscode-docker",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python",
        "python.linting.enabled": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
